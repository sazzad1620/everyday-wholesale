<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (offers). "development" is correct here: Xcode
	     swaps it for "production" automatically when archiving for TestFlight /
	     the App Store with automatic signing. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
