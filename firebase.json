{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "everyday-wholesale",
          "appId": "1:339861351370:android:6512b973e8555461ce3d33",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "everyday-wholesale",
          "configurations": {
            "android": "1:339861351370:android:6512b973e8555461ce3d33",
            "ios": "1:339861351370:ios:57e54cd93b7e1517ce3d33",
            "web": "1:339861351370:web:0cebbf8118e885a1ce3d33"
          }
        }
      }
    }
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node tool/web/check_stripe_key.js",
      "flutter build web --release --wasm --dart-define-from-file config/stripe_live.json",
      "node tool/web/finalize_build.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemap",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/",
        "function": {
          "functionId": "ssr",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/home",
        "function": {
          "functionId": "ssr",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/home/**",
        "function": {
          "functionId": "ssr",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "/main.dart.@(js|mjs|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(app.html|index.html|flutter_bootstrap.js|flutter.js|flutter_service_worker.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{account,admin,cart,categories,wishlist,checkout,order-confirmation,support}{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/{icons,assets/assets/images,assets/fonts,assets/packages}/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ]
  }
}
