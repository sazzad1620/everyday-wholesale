{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "everyday-wholesale",
          "appId": "1:339861351370:android:6512b973e8555461ce3d33",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "everyday-wholesale",
          "configurations": {
            "android": "1:339861351370:android:6512b973e8555461ce3d33",
            "ios": "1:339861351370:ios:57e54cd93b7e1517ce3d33",
            "web": "1:339861351370:web:0cebbf8118e885a1ce3d33"
          }
        }
      }
    }
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
